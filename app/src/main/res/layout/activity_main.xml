<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3D6">

    <!--
        WEBSITE

        WebView itself is edge-to-edge,
        but MainActivity applies system-bar
        padding ONLY to this view.
    -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF3D6"
        android:overScrollMode="never" />


    <!--
        OPENING SCREEN

        This layer remains completely edge-to-edge.
        No system-bar padding is applied here.
    -->
    <FrameLayout
        android:id="@+id/openingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF3D6"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/openingImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/kaveri_splash_1"
            android:scaleType="centerCrop"
            android:contentDescription="Kaveri Sweets" />

    </FrameLayout>

</FrameLayout>
